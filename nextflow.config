params.assemblies = "$launchDir/assemblies.tsv"
params.dates = "$launchDir/dates.tsv"
params.reffile = "$launchDir/reference_genome/*"

params.gubbins_iterations = 100
params.bootstrap_replicates = 1000

params.subsample_count = 10
params.subsample_tipcount = 100
params.simtrees = 10
params.nboot_on_simtree = 1

profiles {

    standard {
        process.executor = 'local'
        process.cpus = 10
        process.memory = "20 GB"

        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "/home/tamas/Containers"
    }
    
    cluster {
        process.executor = 'local'
        process.cpus = 30
        process.memory = "100 GB"

        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "/node8_R10/stamas/containers"
        singularity.runOptions = "--bind /node8_R10:/node8_R10"
    }
}

