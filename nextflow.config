profiles {

    standard {
        process.executor = 'local'
        process.cpus = 10
        process.memory = "20 GB"

        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "/home/tamas/Containers"
    }
    
    cluster {
        process.executor = 'local'
        process.cpus = 30
        process.memory = "100 GB"

        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "/node8_R10/kintses_lab/containers"
        singularity.runOptions = "--bind /node8_R10,/node10_R10,/home"
    }
}

params {
    // Input parameters
    assemblies = "$launchDir/assemblies.tsv"
    clock = "strict"
    reference_genome = null
    gubbins_iterations = 10
    bootstrap_replicates = 1000
    root_method = "all"
    root_topn = "rtt_rms"
    // Output parameters
    resdir = "results"
}